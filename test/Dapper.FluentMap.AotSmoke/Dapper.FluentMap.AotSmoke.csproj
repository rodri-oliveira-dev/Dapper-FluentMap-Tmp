<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Dapper.FluentMap\Dapper.FluentMap.csproj" Condition="'$(PublishTrimmed)' != 'true' And '$(PublishAot)' != 'true'" />
    <ProjectReference Include="..\..\src\Dapper.FluentMap.Generators\Dapper.FluentMap.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Condition="'$(DefineConstants)' == 'AOT_SMOKE_GENERATED' And '$(PublishTrimmed)' != 'true' And '$(PublishAot)' != 'true'" />
    <Reference Include="Dapper.FluentMap" Condition="'$(PublishTrimmed)' == 'true' Or '$(PublishAot)' == 'true'">
      <HintPath>..\..\src\Dapper.FluentMap\bin\$(Configuration)\netstandard2.0\Dapper.FluentMap.dll</HintPath>
    </Reference>
    <PackageReference Include="Dapper" Version="2.1.79" />
  </ItemGroup>
  <ItemGroup Condition="'$(DefineConstants)' == 'AOT_SMOKE_GENERATED' And ('$(PublishTrimmed)' == 'true' Or '$(PublishAot)' == 'true')">
    <Analyzer Include="..\..\src\Dapper.FluentMap.Generators\bin\$(Configuration)\netstandard2.0\Dapper.FluentMap.Generators.dll" />
  </ItemGroup>
</Project>
